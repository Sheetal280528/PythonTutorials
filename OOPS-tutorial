#create a class to take name & marks of 3 subjects as argument in constructor, then print the avg using method
class Student_Data:
    def __init__(self, name, submarks):
        self.name       = name
        self.submarks   = submarks

    def cal_avg(self):
        sum = 0
        for el in self.submarks:
            sum = sum + el
        print(self.name, "ur avg marks", sum/3)

s1 = Student_Data("Tony", [67, 89, 56])
print(s1.name, s1.submarks)         #Tony [67, 89, 56] 
s1.cal_avg()                        #Tony ur avg marks 70.66666666666667

#here it self you can change the value of argumnets 
s1.submarks = [55, 55, 55]
s1.cal_avg()                        #Tony ur avg marks 55.0

#Static Method & Decorator

class school:
    def __init__(self, name, city):
        self.name = name
        self.city = city
    @staticmethod                   #this is called decorator, static method is the method which doesn't have self parameter
    def print_school():
        print("welcome to school")
school1 = school("VNS", "Pune")      
print(school1.name, school1.city)   #VNS Pune
school1.print_school()              # welcome to school

#create a class Account with balance & account number, create method for debit & credit
class Account:
    def __init__(self, acc_num, bal):
        self.acc_num = acc_num
        self.bal     = bal
    #debit method
    def debit_fun(self, amount):
        self.amount = amount
        self.bal = self.bal - self.amount
        print("from ur account", self.acc_num, "amount debited ", self.amount, "balance is ", self.bal)
    
    #credit method
    def credit_fun(self, amount):
        self.amount = amount
        self.bal    = self.bal + self.amount
        print("from ur account", self.acc_num, "amount credit ", self.amount, "balance is ", self.bal)    

a1 = Account("a123", 5000)
print(a1.acc_num, a1.bal)
a1.debit_fun(1000)       #from ur account a123 amount debited  1000 balance is  4000
a1.credit_fun(10000)     #from ur account a123 amount credit  10000 balance is  14000
