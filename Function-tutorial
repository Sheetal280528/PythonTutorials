### using recursive function
def rec_fun(n):
    if (n == -1):
        return     ###this will return no value but control
    print(n)
#    print(n, end = " ")
    rec_fun(n-1)

rec_fun(5)

# factorial of n using recursive function
def rec_fact(n):
    if (n == 1 or n == 0):
        return 1
    else:
        return rec_fact(n-1) * n
print(rec_fact(5))

#print the sum of n natural numbers
def sum_func(a):
    sum = 0
    for el in range(1, a+1):
        sum = sum + el
    print("sum: ", sum)
sum_func(10)

def sum_rec(a):
    if (a == 0):
        return 0
    return sum_rec(a-1) + a
print(sum_rec(10))

