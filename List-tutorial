#List Slicing: ending index is not included
marks = [75, 65.5, 90, 100, 25]
#        0   1     2   3    4 --> indexing
#       -5  -4    -3   -2  -1 
print(marks[1:4])   #[65.5, 90, 100]
print(marks[-4:-2]) #[65.5, 90]
print(marks[-1:-4]) #[]
print(marks[-2:-4]) #[]

