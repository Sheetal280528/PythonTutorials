a = [1, 2, 3]
b = [4, 5]

# Using extend() to add elements of b to a
a.extend(b)
print(a)

# Using a tuple
a = [1, 2, 3]
b = (4, 5)
a.extend(b)
print("list+tuple extend: ", a) #list+tuple extend:  [1, 2, 3, 4, 5]

# Using a set
a = [1, 2, 3]
b = {4, 5}
a.extend(b)
print("list+set extend: ",a)  #list+set extend:  [1, 2, 3, 4, 5]

# Using a string
a = ['a', 'b']
b = "cd"
a.extend(b)
