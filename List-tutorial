print("reverse")
age =  [34,56,65,12,33,12]
#        0  1  2  3  4  5
print(age[::-1])              #modifies the original list in reverse order [12, 33, 12, 65, 56, 34]

rev_age = list(reversed(age)) #this method is used to create a new list in reverse order 
print(age)                    #[34, 56, 65, 12, 33, 12]
print(rev_age)                #[12, 33, 12, 65, 56, 34]
print(age)                    #[34, 56, 65, 12, 33, 12]
print(age.insert(1,10))       #None    
age.insert(1,10)
print(age)                    #[34, 10, 56, 65, 12, 33, 12]
age.remove(12)                #removes the first occurance of 12
print(age)                    #[34, 10, 10, 56, 65, 33, 12]
age.remove(10)
print(age)                    #[34, 10, 56, 65, 33, 12]
age.pop(2)                    #pop removes the element present at the index passed, 2 is the index value and 56 will be removed
print(age)                    #[34, 10, 65, 33, 12]

