# collection of unordered items (has no index like dict)
# each element must be unique (no duplicate values)
# each element is immutable (can not be changed) but set is mutable (values can be added or deleted from set but any value can not be modified)
# str, int, float, booleon values, tuple allowed in set (bcz they can not be changed) but no list or dict is allowed in set
null_set = set()
print(null_set)  #set()
print(type(null_set)) #class 'set'

set1 = {1, 0.9, "hello", ("a", "3", "I love u")}
print(type(set1))
print("display set1: ", set1)
print(len(set1)) #4 total number of items
set2 = {2,2,4,4,5,5, "true", True, False}
print(set2)     # {False, True, 2, 4, 5, 'true'} avoids all duplcate values
print(len(set2)) #6

set2.add("sheetal")
print(set2)   #{False, True, 2, 4, 5, 'true', 'sheetal'}
set2.remove("true")
print(set2)   #{False, True, 2, 4, 5, 'sheetal'}

set3 = {1,5,4,7,8}
print(set3)                    #{1, 4, 5, 7, 8}
pop_element = set3.pop()
print(pop_element)             # 1
print("set3: ", set3.pop())    #set3:  4 randomly removes any element
print(set3)                    # {5, 7, 8} remaining values in set
#print(set2.pop())    #True
#print(set2.pop())    #2
set2.clear()
print(set2)   #set()


### Union combins two sets and gives the unique values
set1 = {1,2,3}
set2 = {3,4,5,6}
set3 = set1.union(set2)
print(set3)    #{1, 2, 3, 4, 5, 6} 

print(set1.union(set2)) #{1, 2, 3, 4, 5, 6} no changes in existng sets via union, it creates a new set
print("set1: ", set1)   #set1:  {1, 2, 3}
print("set2: ", set2)   #set2:  {3, 4, 5, 6}

### Intersection combines two sets and gives common values
print(set1.intersection(set2)) #{3}


